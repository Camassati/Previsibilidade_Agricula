#pragma once

// ---------- Identificacao deste no ----------
#define NODE_ID       "esp32_no_sensor_01"
#define IS_ROOT_NODE  true

// ---------- ESP-NOW ----------
// So usados por nos SENSORES (IS_ROOT_NODE = false):
//
// 1. Grave o no raiz primeiro, com IS_ROOT_NODE = true. Ele vai
//    imprimir o MAC dele e o canal Wi-Fi no Monitor Serial assim
//    que conectar.
// 2. Copie o MAC impresso para ROOT_MAC_ADDRESS abaixo.
// 3. Copie o canal impresso para ESPNOW_CHANNEL abaixo.
// 4. So entao grave o firmware no ESP32 sensor (com IS_ROOT_NODE
//    = false).
#define ROOT_MAC_ADDRESS {0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
#define ESPNOW_CHANNEL 1

// ---------- Wi-Fi ----------
// So usado pelo no raiz.
#define WIFI_SSID     "SEU_WIFI"
#define WIFI_PASSWORD "SUA_SENHA"

// ---------- MQTT (HiveMQ Cloud) ----------
#define MQTT_BROKER    "xxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT      8883
#define MQTT_USERNAME  "seu_usuario_hivemq"
#define MQTT_PASSWORD  "sua_senha_hivemq"
#define MQTT_TOPIC     "calculadora_agricola/leituras"
#define MQTT_CLIENT_ID "esp32_raiz_mqtt"

// ---------- Sensor ----------
#define DHTPIN  4
#define DHTTYPE DHT22

// ---------- Timing ----------
#define READ_INTERVAL_MS 1800000UL

// ---------- NTP (hora real, so usado pelo no raiz) ----------
#define NTP_SERVER     "pool.ntp.org"
#define GMT_OFFSET_SEC -10800
#define DAYLIGHT_OFFSET_SEC 0
